# ---------------------------------------------------------------------------
# FlyHub System — variáveis de ambiente
# Copie para .env e preencha. O .env NUNCA vai para o Git.
# ---------------------------------------------------------------------------

# --- Aplicação -------------------------------------------------------------
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Banco de dados --------------------------------------------------------
POSTGRES_USER=flyhub
POSTGRES_PASSWORD=flyhub
POSTGRES_DB=flyhub
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://flyhub:flyhub@db:5432/flyhub

# --- FlightHub / MediaMTX --------------------------------------------------
FLYHUB_RTMP_HOST=mediamtx
FLYHUB_RTMP_PORT=1935
FLYHUB_STREAM_PATH=live/m4td
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554
TUNNEL_ENABLED=false
TUNNEL_PUBLIC_HOST=

# --- Armazenamento ---------------------------------------------------------
DATA_ROOT=/data                     # datasets, imagens, pesos do modelo
DATASETS_DIR=/data/datasets
MODELS_DIR=/data/models

# --- Split temporal (Time Series CV) --------------------------------------
SPLIT_TRAIN_RATIO=0.70
SPLIT_VALID_RATIO=0.15
SPLIT_TEST_RATIO=0.15
SPLIT_EMBARGO_SECONDS=5             # janela descartada entre blocos (anti-leakage)

# --- Roboflow (NUNCA commitar valores reais) -------------------------------
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
ROBOFLOW_API_URL=https://api.roboflow.com

# --- Frontend (build-time, prefixo VITE_) ----------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DRONE_MODEL_URL=/models/drone.glb
