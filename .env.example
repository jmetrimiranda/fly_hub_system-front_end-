# ---------------------------------------------------------------------------
# FlyHub System — variáveis de ambiente
# Copie para .env e preencha. O .env NUNCA vai para o Git.
# ---------------------------------------------------------------------------

# --- Aplicação -------------------------------------------------------------
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Banco de dados --------------------------------------------------------
POSTGRES_USER=flyhub
POSTGRES_PASSWORD=flyhub
POSTGRES_DB=flyhub
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://flyhub:flyhub@db:5432/flyhub

# --- FlightHub / MediaMTX --------------------------------------------------
# O MediaMTX roda no HOST, fora deste Compose: quem o sobe é o `./start.sh` do
# M4TD. `host.docker.internal` só resolve dentro do container por causa do
# `extra_hosts: ["host.docker.internal:host-gateway"]` no serviço `backend` do
# docker-compose.yml — preferido a fixar o IP da rede local, que muda.
#
# Para apontar para o MediaMTX do compose (profile `stream`), troque as duas
# URLs por `mediamtx` no lugar de `host.docker.internal`.
FLYHUB_RTMP_HOST=mediamtx
FLYHUB_RTMP_PORT=1935
FLYHUB_STREAM_PATH=live/m4td
MEDIAMTX_API_URL=http://host.docker.internal:9997
MEDIAMTX_RTSP_URL=rtsp://host.docker.internal:8554

# Endereço público fixo que o operador cola no FlightHub. É o `PUBLIC_HOST` do
# start.sh do M4TD: com ele o endereço NÃO muda entre reinícios. Vazio faz o
# endereço ser montado com o host do MediaMTX.
FLYHUB_PUBLIC_HOST=

# O túnel (bore) só existe para dar endereço alcançável a máquina sem IP
# público, e o endereço dele muda a cada reinício. Com FLYHUB_PUBLIC_HOST
# definido, é dispensável.
TUNNEL_ENABLED=false
TUNNEL_PUBLIC_HOST=

# --- Fonte de telemetria de voo --------------------------------------------
# `fake` percorre uma rota de inspeção simulada sobre o Terminal Marítimo de
# Ponta Ubu e faz a aplicação inteira se comportar como conectada, sem hardware.
# É o padrão de propósito: permite desenvolver sem o M4TD no ar.
#
# `real` consulta o MediaMTX de verdade e consome o RTSP — os quatro
# indicadores e a tabela CONEXÃO passam a refletir o broker. A posição GPS
# continua ausente: ela depende do FlightHub Sync, que é o que `mqtt` reserva
# (ainda não implementado; levanta erro na subida).
FLIGHT_SOURCE=fake                  # fake | real | mqtt
FAKE_FLIGHT_INTERVAL=1.0            # segundos entre amostras
FAKE_FLIGHT_SPEED_MS=6.0            # velocidade de cruzeiro
FAKE_FLIGHT_CENTER_LAT=-20.78667    # Ponta Ubu, Anchieta/ES
FAKE_FLIGHT_CENTER_LON=-40.57333

# --- Vídeo e inferência ----------------------------------------------------
# Pesos ausentes NÃO são erro: é o estado inicial do projeto. O detector entra
# em passthrough, devolve o quadro intacto e a tela diz `SEM MODELO — vídeo
# cru`. Para inferir de verdade: pip install -r backend/requirements-vision.txt
MODEL_WEIGHTS=                      # vazio = MODELS_DIR/best.pt
MODEL_CONF=0.25                     # limiar de confiança passado ao predict
JPEG_QUALITY=80                     # qualidade dos quadros do MJPEG

# --- Armazenamento ---------------------------------------------------------
DATA_ROOT=/data                     # datasets e imagens (volume do Docker)
DATASETS_DIR=/data/datasets
# Pasta `models/` do repositório, montada no container. Fora de /data de
# propósito: quem treina copia o best.pt para uma pasta da árvore do projeto,
# sem precisar saber o que é um volume. Ver models/README.md.
MODELS_DIR=/models
DISK_LIMIT_PCT=90                   # acima disto a coleta nao inicia e pausa sozinha

# --- Coleta de quadros -----------------------------------------------------
# Padroes que o modal de confirmacao pre-preenche. O operador pode mudar
# intervalo, limite e dedup a cada coleta; o que esta aqui e o ponto de partida.
COLLECT_INTERVAL_SECONDS=2.0        # 0.5 | 1 | 2 | 5 — as opcoes do modal
COLLECT_FRAME_LIMIT=500             # vazio no modal = ilimitado
# Maior que JPEG_QUALITY de proposito: o MJPEG e descartavel, o quadro gravado
# vai treinar um modelo e nao deve levar artefato que a camera nao produziu.
COLLECT_JPEG_QUALITY=92
COLLECT_QUEUE_MAX=20                # quadros na fila de escrita; cheia, descarta
COLLECT_WRITERS=2                   # teto: mais threads disputariam CPU com o MJPEG
COLLECT_WRITER_NICE=10              # a coleta cede CPU para o video, nunca o contrario
# Diferenca media absoluta (0-255) abaixo da qual dois quadros sao "o mesmo".
# Medido no M4TD com o drone pairando: 2.0 descarta o enquadramento parado e
# mantem a translacao lenta.
DEDUP_THRESHOLD=2.0

# --- Split temporal (Time Series CV) --------------------------------------
SPLIT_TRAIN_RATIO=0.70
SPLIT_VALID_RATIO=0.15
SPLIT_TEST_RATIO=0.15
SPLIT_EMBARGO_SECONDS=5             # janela descartada entre blocos (anti-leakage)
# O M4TD media a margem em QUADROS (DEFAULT_MARGIN=5), esta plataforma media em
# SEGUNDOS. Aplica-se a uniao das duas: a de tempo cobre o intervalo irregular
# que a deduplicacao produz, a de quadros garante o minimo de vizinhos
# descartados quando o intervalo de amostragem e longo. Nunca menos que o M4TD.
SPLIT_EMBARGO_FRAMES=5

# --- Segredo do processo ---------------------------------------------------
# Deriva a chave que cifra as credenciais do Roboflow em repouso. Sem ela a
# aplicacao sobe, mas RECUSA gravar credencial e explica o motivo na tela — nao
# ha chave padrao, e um segredo efemero produziria um banco que nao reabre.
# Gere com: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
SECRET_KEY=

# --- Roboflow (NUNCA commitar valores reais) -------------------------------
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
ROBOFLOW_API_URL=https://api.roboflow.com

# --- Frontend (build-time, prefixo VITE_) ----------------------------------
# O serviço `frontend` do docker-compose.yml NÃO carrega este arquivo inteiro:
# ele não deve ver ROBOFLOW_API_KEY nem POSTGRES_PASSWORD. Cada VITE_* precisa
# estar repassada, uma a uma, no bloco `environment:` daquele serviço. Se você
# acrescentar uma variável aqui e ela não aparecer no Vite, é isso.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Ainda NÃO repassada no compose, de propósito: `DroneViewer` liga o modelo 3D
# só de a variável existir, e `frontend/public/models/drone.glb` ainda não está
# no repositório. Quando estiver, descomente a linha correspondente no compose.
VITE_DRONE_MODEL_URL=/models/drone.glb
